<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Szablon. Znaczniki __PYTHON__, __SYSTEM__, __LOKALNE__ podmienia mac-zainstaluj.sh. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>pl.integrate.zbieracz</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON__</string>
		<string>__SYSTEM__/zbieracz.py</string>
		<string>zbierz</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__SYSTEM__</string>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>__LOKALNE__/zbieracz.log</string>
	<key>StandardErrorPath</key>
	<string>__LOKALNE__/zbieracz.log</string>
</dict>
</plist>
