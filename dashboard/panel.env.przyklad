# Ustawienia panelu. Skopiuj ten plik jako panel.env (w tym samym folderze) i zmień to, czego potrzebujesz.
# Wiersz: NAZWA=wartość, bez cudzysłowów. Wiersz zaczęty od # jest pominięty. Zmienna środowiska wygrywa z plikiem.
# panel.env zawiera hasło i token: nie dodawaj go do repozytorium ani do kopii, które komuś udostępniasz.
# Opis zmiennych: AGENCI.md. Po zmianie uruchom panel ponownie.

# Adres serwera. 127.0.0.1: tylko ten komputer. 0.0.0.0: także inne urządzenia (wtedy ustaw PANEL_TOKEN).
PANEL_HOST=127.0.0.1
PANEL_PORT=4801

# Dodatkowe nazwy, pod którymi otwierasz panel, po przecinku (np. nazwa komputera w Tailscale).
# PANEL_ALLOWED_HOSTS=

# Hasło panelu dla połączeń spoza tego komputera. Bez hasła takie połączenia są odrzucane.
# PANEL_TOKEN=

# Nazwa węzła: pc albo mac. Bez wpisu: mac na macOS, w innym systemie pc.
# PANEL_MACHINE=pc

# Ścieżki poleceń, gdy nie ma ich w PATH.
# PANEL_CLAUDE=
# PANEL_CODEX=

# Ile uruchomień naraz i limit czasu jednego uruchomienia (sekundy).
PANEL_AGENTS_MAX=2
PANEL_AGENT_TIMEOUT=3600

# Model dla zadań i dla raportu PM. Bez wpisu: model domyślny narzędzia.
# PANEL_AGENT_MODEL=
# PANEL_PM_MODEL=

# Godzina dziennego raportu PM w Automacie (0–23).
PANEL_PM_HOUR=7

# 1: przed uruchomieniem zadania git pull --ff-only w projekcie, gdy repozytorium jest czyste.
PANEL_GIT_PULL=0

# Adres tematu ntfy. Po zakończeniu uruchomienia tytuł zadania trafia na ten serwer.
# PANEL_NTFY_URL=

# Token z polecenia claude setup-token, dla komputera bez przeglądarki. Wpisujesz go samodzielnie.
# CLAUDE_CODE_OAUTH_TOKEN=
