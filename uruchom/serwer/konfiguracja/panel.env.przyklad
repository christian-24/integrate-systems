# Wzór /etc/integrate/panel.env na serwerze (root:root 600). Wartości oznaczone <z menedżera haseł> wpisuje właściciel.
# Pełny opis zmiennych: dashboard/AGENCI.md i dashboard/panel.env.przyklad.
PANEL_HOST=127.0.0.1
PANEL_PORT=4801
# Adres panelu bez https:// (ten sam co w Caddyfile).
PANEL_ALLOWED_HOSTS=<adres panelu>
PANEL_MACHINE=cloud
PANEL_CLAUDE=/home/panel/.local/bin/claude
PANEL_AGENTS_MAX=2
PANEL_AGENT_TIMEOUT=3600
PANEL_PM_HOUR=7
# Stan kontroli zdrowia i ostatniej kopii (widok serwera w panelu).
PANEL_ZDROWIE_STAN=/home/panel/.zdrowie-stan
PANEL_KOPIA_STAN=/home/panel/kopie/ostatnia.json
# Sekrety:
PANEL_TOKEN=<z menedżera haseł>
PANEL_NTFY_URL=<z menedżera haseł>
