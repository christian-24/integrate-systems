[Unit]
Description=Google Drive Shield & Silent tylko do odczytu (rclone) w szkice/shield-silent/media/drive
Documentation=file:///home/panel/IntegrateSystems/uruchom/serwer/zainstaluj-drive.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=panel
Group=projekty
Environment=HOME=/home/panel
# Konfiguracja z tokenem: /home/panel/.config/rclone/rclone.conf (0600, panel); konto agent jej nie czyta.
# Pliki widzi panel i grupa projekty (agent), tylko do odczytu; pamięć podręczna do 1 GB w ~/.cache/rclone.
ExecStart=/usr/bin/rclone mount drive-shield: /home/panel/IntegrateSystems/szkice/shield-silent/media/drive \
  --config /home/panel/.config/rclone/rclone.conf --read-only --allow-other --uid @UID@ --gid @GID@ --umask 0027 \
  --vfs-cache-mode full --vfs-cache-max-size 1G --dir-cache-time 10m --poll-interval 1m
ExecStop=/bin/fusermount3 -u /home/panel/IntegrateSystems/szkice/shield-silent/media/drive
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
