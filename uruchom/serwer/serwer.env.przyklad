# Ustawienia kopii i kontroli zdrowia. Na serwerze: /etc/integrate/serwer.env (root, 600). Wszystkie opcjonalne.
# Opis konfiguracji kopii poza serwerem: ksiega/MIGRACJA.md, sekcja „Kopia poza serwerem”.
#
# Wysyłka kopii poza serwer (puste = kopia tylko na serwerze):
#   rclone:<zdalny>:<folder>   np. rclone:storagebox:integrate (zdalny sftp z `sudo -u panel rclone config`)
#   scp:<host>:<folder>        np. scp:storagebox:integrate (Host storagebox w /home/panel/.ssh/config, klucz bez hasła)
KOPIA_CEL=
# Szyfrowanie przed wysyłką (scp bez szyfrowania jest odrzucany). Jedno z dwóch:
#   gpg symetryczny AES256: plik z hasłem, właściciel panel, prawa 600; hasło także w menedżerze haseł
KOPIA_HASLO_PLIK=
#   age z kluczem publicznym: plik z odbiorcą (age1...); klucz prywatny tylko u właściciela, nie na serwerze
KOPIA_AGE_ODBIORCY=
# rclone: archiwa w celu starsze niż tyle dni są usuwane (0 = bez usuwania). scp nie usuwa.
KOPIA_CEL_DNI=30
# Pełny adres /api/health asystenta Useme; puste = port z nasłuchu usługi useme.
USEME_URL=
# Alarm, gdy wolnego miejsca na dysku jest mniej niż tyle procent.
ZDROWIE_PROG_DYSKU=15
# Godzina dziennego podsumowania ntfy (czas polski).
ZDROWIE_GODZINA_PODSUMOWANIA=8
