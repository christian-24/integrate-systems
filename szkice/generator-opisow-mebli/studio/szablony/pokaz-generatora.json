 "logowanie": "https://opisarnia.pl/logowanie",
 "kroki": [
  {
   "kliknij": "button[aria-label=\"Zamknij informację o zmianie dostawcy\"]",
   "opcjonalnie": true,
   "pauza": 0.4
  },
  {
   "napis": "{{napis_start}}",
   "przewin": "#g-nazwa",
   "pauza": 1.2
  },
  {
   "napis": "{{napis_typ}}",
   "wpisz": [
    "#g-nazwa",
    "{{typ_mebla}}"
   ]
  },
  {
   "wybierz": [
    "#g-kategoria",
    "{{kategoria}}"
   ]
  },
  {
   "napis": "{{napis_wymiary}}",
   "wpisz": [
    "#g-w",
    "{{szerokosc}}"
   ]
  },
  {
   "wpisz": [
    "#g-h",
    "{{wysokosc}}"
   ]
  },
  {
   "wpisz": [
    "#g-d",
    "{{glebokosc}}"
   ]
  },
  {
   "wpisz": [
    "#g-mat",
    "{{material}}"
   ]
  },
  {
   "rozwin": "details.st-wiecej"
  },
  {
   "wpisz": [
    "#g-kolor",
    "{{kolor}}"
   ]
  },
  {
   "napis": "{{napis_generuj}}",
   "kliknij": "[aria-label='Wybierz marketplace'] button:has-text('Allegro')"
  },
  {
   "kliknij": "button:has-text('Generuj opis')"
  },
  {
   "napis": "{{napis_czekaj}}",
   "czekaj_na": "button:has-text('Kopiuj')",
   "limit": 90
  },
  {
   "napis": "{{napis_pl}}",
   "przewin": "[role=tablist][aria-label='Język opisu']",
   "pauza": 3.5
  },
  {
   "napis": "{{napis_de}}",
   "kliknij": "[role=tab]:has-text('Niemiecki')",
   "pauza": 4
  }
 ]
}